1. Core Rust Enumeration & Smart Contract Data Structures
​The following contract logic defines the four shards, capacity constraints, master sentinel metadata, and anti-tampering logic designed to resist state or occult mirroring (Crypto Minus (run miners mad) protection).

use borsh::{BorshDeserialize, BorshSerialize};
use near_sdk::borsh;
use near_sdk::{env, near_bindgen, AccountId, PanicOnDefault};
use near_sdk::collections::UnorderedMap;
use serde::{Deserialize, Serialize};

/// Maximum localized NFT capacity per shard (Strictly capped at 222)
pub const SHARD_CAPACITY: u32 = 222;

#[derive(BorshSerialize, BorshDeserialize, Serialize, Deserialize, Clone, Copy, PartialEq, Debug)]
pub enum ShardId {
    TruthShard = 0,
    SoundShard = 1,
    MathsShard = 2,
    SkillShard = 3,
}

#[derive(BorshSerialize, BorshDeserialize, Serialize, Deserialize, Clone, Debug)]
pub struct MasterSentinelMetadata {
    pub shard_id: ShardId,
    pub sentinel_address: AccountId,
    pub cryptographic_core: String,
    pub visual_concept: String,
    pub current_nodes_minted: u32,
}

#[near_bindgen]
#[derive(BorshDeserialize, BorshSerialize, PanicOnDefault)]
pub struct UniqueIsRichL1Mainnet {
    pub owner_id: AccountId,
    pub sentinels: UnorderedMap<u8, MasterSentinelMetadata>,
    pub anti_mirror_registry: UnorderedMap<AccountId, bool>, // Blocks "Mad Monitor" spiritual tracking
}

#[near_bindgen]
impl UniqueIsRichL1Mainnet {
    #[init]
    pub fn new(owner_id: AccountId) -> Self {
        assert!(!env::state_exists(), "Already initialized");
        
        let mut this = Self {
            owner_id,
            sentinels: UnorderedMap::new(b"s".to_vec()),
            anti_mirror_registry: UnorderedMap::new(b"a".to_vec()),
        };

        // Initialize Master Sentinels for each Shard
        this.register_sentinel(ShardId::TruthShard, "shard_0.uniqueisrich.near", "10221301-ORIGIN-IB-LOS", "Crystalline prism holding a burning gold timestamp matrix (13:01).");
        this.register_sentinel(ShardId::SoundShard, "shard_1.uniqueisrich.near", "011996-TRANSIT-LOS", "Shifting acoustic wave arrays projecting off a Lagos cityscape bridge.");
        this.register_sentinel(ShardId::MathsShard, "shard_2.uniqueisrich.near", "uniqueisrich-LOGIC", "Multi-dimensional geometric matrix decrypting complex hexadecimal streams.");
        this.register_sentinel(ShardId::SkillShard, "shard_3.uniqueisrich.near", "POSITRON-ADAPT-EVO", "Advanced cybernetic mesh helmet glowing with high-tier cobalt circuits.");

        this
    }

    fn register_sentinel(&mut self, shard_id: ShardId, address: &str, core: &str, visual: &str) {
        let metadata = MasterSentinelMetadata {
            shard_id,
            sentinel_address: address.parse().unwrap(),
            cryptographic_core: core.to_string(),
            visual_concept: visual.to_string(),
            current_nodes_minted: 0,
        };
        self.sentinels.insert(&(shard_id as u8), &metadata);
    }

    /// Mint localized NFT within a shard while enforcing the 222 capacity limit
    pub fn mint_shard_node(&mut self, shard_id: ShardId) -> String {
        let key = shard_id as u8;
        let mut sentinel = self.sentinels.get(&key).expect("Shard sentinel not found");

        assert!(
            sentinel.current_nodes_minted < SHARD_CAPACITY,
            "Shard capacity of 222 reached. Immutable boundary locked."
        );

        sentinel.current_nodes_minted += 1;
        self.sentinels.insert(&key, &sentinel);

        format!(
            "SUCCESS: Minted node #{} in Shard {:?} under Sentinel {}",
            sentinel.current_nodes_minted, shard_id, sentinel.sentinel_address
        )
    }

    /// Anti-Mirror Protocol: Rejects unauthorized telemetry or "Mad Monitor" siphoning attempts
    pub fn verify_sovereignty(&self, target: AccountId) -> bool {
        !self.anti_mirror_registry.get(&target).unwrap_or(false)
    }
}


