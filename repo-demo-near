4. Running the Testnet Demo via NEAR CLI
# 1. Build WASM contract for NEAR
cargo build --target wasm32-unknown-unknown --release

# 2. Deploy to NEAR Testnet account
near contract deploy uniqueisrich-demo.testnet \
  use-file target/wasm32-unknown-unknown/release/uniqueisrich_hackathon_demo.wasm \
  with-init-call new \
  json-args '{"owner_id": "uniqueisrich-demo.testnet"}' \
  send

# 3. Test Artistry Binary Gate (0110000101110101 -> 24949)
near contract call-function as-read-only uniqueisrich-demo.testnet \
  verify_artistry_binary \
  json-args '{"binary_str": "0110000101110101"}' \
  network-config testnet

# 4. Mint Utility Node on Shard 0 (Truth)
near contract call-function as-transaction uniqueisrich-demo.testnet \
  mint_sovereign_node \
  json-args '{"shard_id": "TruthShard"}' \
  prepaid-gas '100.000 Tgas' \
  attached-deposit '0 NEAR' \
  sign-as uniqueisrich-demo.testnet \
  network-config testnet


